{
  "info": {
    "_postman_id": "6f2c1d8e-3b4a-4c5d-9e7f-1a2b3c4d5e6f",
    "name": "Finanzas Personales - API REST",
    "description": "Pruebas de la API REST con JWT. Se ejecuta en orden con el Collection Runner usando el entorno Finanzas - Local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isAuthRequest = pm.request.url.toString().includes(\"/api/auth/\");",
          "if (!isAuthRequest && !pm.environment.get(\"jwt_token\")) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get(\"base_url\") + \"/api/auth/login\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\" },",
          "        body: {",
          "            mode: \"raw\",",
          "            raw: JSON.stringify({",
          "                email: pm.environment.get(\"admin_email\"),",
          "                password: pm.environment.get(\"admin_password\")",
          "            })",
          "        }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set(\"jwt_token\", res.json().accessToken);",
          "            pm.environment.set(\"admin_token\", res.json().accessToken);",
          "        }",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responde en menos de 2 segundos\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "description": "Login de los usuarios de prueba y registro de una cuenta nueva. Guarda los tokens en el entorno.",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Devuelve un accessToken con formato JWT\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"accessToken\");",
                  "    pm.expect(body.accessToken.split(\".\")).to.have.lengthOf(3);",
                  "    pm.environment.set(\"jwt_token\", body.accessToken);",
                  "    pm.environment.set(\"admin_token\", body.accessToken);",
                  "});",
                  "",
                  "pm.test(\"El payload trae el correo, el rol ADMIN y las fechas\", function () {",
                  "    const token = pm.response.json().accessToken;",
                  "    const payload = JSON.parse(atob(token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "    pm.expect(payload.sub).to.eql(pm.environment.get(\"admin_email\"));",
                  "    pm.expect(payload.authorities).to.include(\"ROLE_ADMIN\");",
                  "    pm.expect(payload.authorities).to.include(\"USER_READ\");",
                  "    pm.expect(payload.exp).to.be.above(payload.iat);",
                  "    pm.expect(payload).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login usuario Ana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El token de Ana tiene el rol USER y no tiene permisos de administracion\", function () {",
                  "    const token = pm.response.json().accessToken;",
                  "    pm.environment.set(\"user_token\", token);",
                  "    const payload = JSON.parse(atob(token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "    pm.expect(payload.authorities).to.include(\"ROLE_USER\");",
                  "    pm.expect(payload.authorities).to.not.include(\"USER_READ\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
